{
  "name": "stsh-wallet",
  "version": "0.1.0",
  "private": true,
  "description": "STSH — privacy wallet frontend",
  "scripts": {
    "dev": "vite",
    "prebuild": "node ../scripts/verify_spend_artifacts.mjs",
    "build": "npm run build:wasm && tsc && vite build",
    "build:transitional": "WALLET_CONFIG_VARIANT=transitional npm run build",
    "build:wasm": "wasm-pack build ../circuits/poseidon-wasm --target web --out-dir ../../wallet/src/wasm/poseidon",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@dfinity/agent": "3.4.3",
    "@dfinity/auth-client": "3.4.3",
    "@dfinity/candid": "3.4.3",
    "@dfinity/identity": "3.4.3",
    "@dfinity/ledger-icp": "5.0.0",
    "@dfinity/ledger-icrc": "3.0.0",
    "@dfinity/oisy-wallet-signer": "0.4.0",
    "@dfinity/principal": "3.4.3",
    "@dfinity/utils": "3.2.0",
    "@dfinity/vetkeys": "0.4.0",
    "@dfinity/zod-schemas": "1.1.0",
    "hash-wasm": "4.12.0",
    "idb": "^8.0.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "fake-indexeddb": "6.2.5",
    "jsdom": "^24.0.0",
    "snarkjs": "0.7.5",
    "typescript": "^5.4.0",
    "vite": "^5.2.0",
    "vitest": "^1.5.0",
    "wasm-pack": "^0.12.0"
  },
  "engines": {
    "node": "22.23.1",
    "npm": "10.9.8"
  },
  "packageManager": "npm@10.9.8"
}
