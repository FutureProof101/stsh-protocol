// =============================================================================
// STSH — CANONICAL stsh_token INIT ARTIFACT (P-ARITH G-1; principals RESOLVED at RR-1a)
// =============================================================================
// THE exact Candid init argument the mainnet deploy consumes — Gate-D
// (scripts/verify_genesis_manifest) verifies EVERY field of this artifact
// against deployment/mainnet/genesis_manifest.toml and records its SHA-256.
// The deploy must pass THIS FILE to dfx (--argument-file); reconstructing the
// args by hand is a Gate-D violation (adversarial vector: reconstructed args
// differing from the verified artifact).
//
// Canonical forms (no discretion): subaccount = null on every allocation;
// created_at_genesis = false; genesis_timestamp_ns = 0 (canister overwrites
// both during init); vesting_policy = null on every row.
//
// LANE A-2 (2026-09-09): the allocation vector is the V4 D-0 table as amended by
// D-4/D-5, in the canonical D-7 row order. Gate-D zips this vector POSITIONALLY
// against the manifest and against APPROVED_ALLOCATIONS — the order is a
// contract, not a presentation choice.
// =============================================================================
(
  record {
    allocations = vec {
      // V4 D-0 bucket 1, AMENDED 27% -> 30% by RULING_RECORD_GENESIS_REALLOCATION_2026-09-12.md
      // (a14beef1, Owner): +3% of the 6% released by the founders 18% -> 12% reduction.
      // Was 29.5% — the counsel grant is bucket-4 funded (Addendum C Q3 -> Owner Addendum D).
      record {
        category_id = "treasury";
        category_name = "Protocol Treasury";
        amount = 30_000_000_000_000_000 : nat;
        recipient = principal "7aacs-7ky4d-2f7wg-rq4yh-c6us4-gmzow-inzyz-mdglq-ov72c-hx4zc-gae";
        subaccount = null;
        lock_policy = variant { GovernanceLocked };
        vesting_policy = null;
        created_at_genesis = false;
        genesis_timestamp_ns = 0 : nat64;
      };
      // V4 D-0 bucket 2 (12%). Surviving category_id `insurance` (Addendum E Q5).
      record {
        category_id = "insurance";
        category_name = "Security & Recovery Reserve";
        amount = 12_000_000_000_000_000 : nat;
        recipient = principal "txsc4-jhhef-eqw7h-tdqpd-7eior-6zbfc-r3o6e-7gi7q-jja7q-dpgij-vqe";
        subaccount = null;
