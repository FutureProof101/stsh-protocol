# STSH wallet — LOCAL / DRY-RUN environment only (Vite build-time, VITE_*)
#
# ── READ THIS FIRST (WT-1 Addendum A, CTO ruling 2026-09-14) ─────────────────
# The SHIPPED mainnet bundle uses NONE of these. Every live canister id is a
# hardcoded `DEFAULT_*` constant in `src/session/config.ts`, consumed through the
# `??` fallback. That is deliberate and binding:
#   - `[wallet_bundle].command` (deployment/mainnet/release_hashes.toml) is a
#     bare `cd wallet && npm run build`, `run_gate.sh` sets no VITE_*, and
#     `vite.config.ts` injects only `[build].source_sha` — so an env-supplied id
#     would be INVISIBLE to the pinned, measured build;
#   - a stray `wallet/.env` or `.env.local` WOULD be auto-loaded by Vite and
#     would silently change the bundle whose sha256 is pinned in the record,
#     making it reproducible on exactly one machine.
# `wallet/.env*` must therefore NOT EXIST — asserted by
# `tests/wt1_canister_rooted_identity.test.ts` (AC-15a). This `.env.example` is
# the only tracked env file; it is loaded by nothing.
#
# Production notes for the overrides that remain meaningful locally:
# - VITE_II_URL must be UNSET in production: the app uses the reviewed
#   @dfinity/auth-client 3.4.3 default provider, and a production override is
#   rejected at runtime (session policy). Loopback-only.
# - The II DERIVATION ORIGIN is no longer an env var at all. WT-1 roots
#   principals at the wallet canister's own origin, and the value is loaded at
#   RUNTIME from the same-origin `public/wallet-config.json` so that the
#   transitional and final deployments differ by a deployed asset rather than by
#   a rebuild. `VITE_DERIVATION_ORIGIN` is gone; do not reintroduce it.
# - VITE_FETCH_ROOT_KEY only takes effect for an explicit loopback
#   VITE_IC_HOST; a mainnet host never fetches the root key.

VITE_IC_HOST=http://127.0.0.1:8080
VITE_FETCH_ROOT_KEY=true
VITE_II_URL=
VITE_TOKEN_CANISTER_ID=
VITE_VESTING_CANISTER_ID=
# Staking is NOT INSTALLED at launch (D1, 2026-08-14): it has no mainnet
# principal, and is the one id with no compiled-in default.
VITE_STAKING_CANISTER_ID=

# ── Campaign B / L3a (shield) ────────────────────────────────────────────────
# All four wiring principals below feed the C-DOM-2 deployment-config hash the
# pool authoritatively verifies inside shield_deposit — an incomplete or wrong
# wiring fails closed before any funds move. Not cosmetic config.
VITE_POOL_CANISTER_ID=
VITE_MERKLE_CANISTER_ID=
VITE_NULLIFIER_CANISTER_ID=
VITE_VETKEYS_CANISTER_ID=
# L3c: the verifier principal is part of the deployment-wiring tuple the manifest
# attestation check compares against the pool's OWN attestation. `config.ts` has
# read this since L3c; it was missing from this file and from `vite-env.d.ts`
# until WT-1 (Addendum A F-2).
VITE_VERIFIER_CANISTER_ID=
# The custody ring (operator page only). Both default to the pinned mainnet
# principals; override only for a local replica dry run.
VITE_VAULT_CANISTER_ID=
VITE_UPGRADER_CANISTER_ID=
# The ceremony-frozen pool principal the note crypto is bound to. Leave UNSET
# to use the pinned production default; a production runtime pool principal
# that differs from it disables shield/spend (C-DOM-2).
VITE_FROZEN_POOL_CANISTER_ID=
# vetKD key name for LOCAL/TEST builds ONLY (C-VK-3): must be set explicitly
# (e.g. dfx_test_key); production ignores this and pins "key_1". Never
# defaulted — an unset value disables shield on a local build.
VITE_VETKD_KEY_NAME=dfx_test_key
