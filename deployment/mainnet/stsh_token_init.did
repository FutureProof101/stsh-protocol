    treasury = principal "7aacs-7ky4d-2f7wg-rq4yh-c6us4-gmzow-inzyz-mdglq-ov72c-hx4zc-gae";
    staking_canister = principal "cpdab-saaaa-aaaar-qca2q-cai";
    fee_collector = opt principal "jdc4c-utkoi-nekq7-h7fod-ewtgg-jqeak-tde3m-t7v7j-m5hq3-lnaoz-yae";
    // HARDEN-03-SETTLEMENT (D-3) added `pool_canister : opt principal` to the
    // token's InitArgs: the shielded pool whose qualifying deposit transfers
    // receive a durable receipt. INIT-TIME ONLY — D-3 refused a setter
    // deliberately, so this value is chosen once, here, and the only way to
    // change it afterwards is a reinstall of the ledger.
    //
    // BOUND, NOT NULL — CTO ruling 2026-09-18 (SETTLEMENT-CLOSE). The builder
    // first regenerated this artifact with `null` (the fail-safe value: no
    // receipts written, settlement returns DepositSettlementUnavailable) on the
    // ground that choosing a principal is a genesis-value decision above a
    // builder seat, and referred it up. The ruling: `pool_canister` must NOT
    // ship null, because the token has no setter, the pool principal has been
    // immutable since J-18, and shipping settlement inert would silently
    // disable the lane being merged.
    //
    // The value is the Vault-born pool — `canister_ids.json` `shielded_pool.ic`,
    // and the SAME principal the A-3 FINALIZE ceremony re-encoded the commitment
    // domain to (045fed0). It is a J-18 birth, so verify_a7_kit's principal
    // check resolves it.
    pool_canister = opt principal "cxrfg-qaaaa-aaaar-qchfa-cai";
